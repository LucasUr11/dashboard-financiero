# ─────────────────────────────────────────────────────────────
# FinHub — Variables de entorno
# Copiá este archivo como .env y completá con tus credenciales.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Turso / libSQL) ──────────────────────────
# URL de tu base de datos en Turso (la obtenés con `turso db show <nombre> --url`)
DATABASE_URL="libsql://tu-base.turso.io"
# Token de autenticación de Turso (`turso db tokens create <nombre>`)
TURSO_AUTH_TOKEN=""
# Alias explícito de Turso (opcional — toma precedencia sobre DATABASE_URL)
# TURSO_DATABASE_URL="libsql://tu-base.turso.io"

# ── Servidor API (Hono) ─────────────────────────────────────
PORT=3001

# ── Frontend (Vite) ─────────────────────────────────────────
# Base URL de la API. Vacío = usa el proxy de Vite en desarrollo (recomendado).
VITE_API_BASE_URL=""
